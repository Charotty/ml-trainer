# CT Workbench — GPU image with PyTorch CUDA + TotalSegmentator.
# Requires NVIDIA Container Toolkit on the host.
# Build: docker compose --profile gpu build workbench-gpu

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    MODEL_PATH=/app/models/adaptive_ensemble_clinical_honest.pkl \
    CASES_ROOT=/data/cases \
    PYTHONPATH=/app \
    CUDA_VISIBLE_DEVICES=0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        curl \
        dcm2niix \
        libgomp1 \
        libglib2.0-0 \
        libgl1 \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docker.txt /app/requirements-docker.txt
# Install API stack first, then replace any CPU torch with CUDA wheels.
RUN pip3 install --upgrade pip \
    && pip3 install -r /app/requirements-docker.txt \
    && pip3 uninstall -y torch torchvision torchaudio || true \
    && pip3 install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu124 \
    && pip3 install TotalSegmentator

COPY config /app/config
COPY frontend/public /app/frontend/public
COPY models/phase1 /app/models/phase1
COPY scripts/inference /app/scripts/inference
COPY scripts/validation/common.py /app/scripts/validation/common.py
COPY src /app/src

RUN mkdir -p /app/models /data/cases /root/.totalsegmentator

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8010/health || exit 1

CMD ["python3", "-m", "uvicorn", "src.api.ct_workbench_api:app", \
     "--host", "0.0.0.0", "--port", "8010", "--workers", "1"]
